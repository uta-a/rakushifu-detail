{
  "expo": {
    "name": "らくしふ詳細",
    "slug": "rakushifu-detail",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rakushifu-detail",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android"
    ],
    "android": {
      "package": "com.utaa.rakushifu",
      "versionCode": 2,
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#171717",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#171717",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76,
          "dark": {
            "backgroundColor": "#171717"
          }
        }
      ],
      "expo-secure-store",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# WorkManager（expo-background-task）は WorkDatabase_Impl をリフレクションで作る。\n# Room 2.6 の keep ルールはクラスだけでコンストラクタを残さず、R8 の full mode で消されて起動時に落ちる\n-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0dde2a51-62d7-4dc6-a3b6-fe55d62d0e6d"
      }
    },
    "owner": "uta_a"
  }
}
